# CampusAssist API Environment Configuration Example

# 1. Server Configuration
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173,https://campusassist.vercel.app

# 2. Authentication & Security (JWT)
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# 3. Aiven MySQL Database Connection
# Paste your credentials from console.aiven.io below
MYSQL_HOST=mysql-xxxx-yourname.aivencloud.com
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_password_here
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true

# 4. Google Gemini Developer API (Server-side)
# Obtain your key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
